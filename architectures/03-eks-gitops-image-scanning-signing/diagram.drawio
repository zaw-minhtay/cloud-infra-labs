ry"><mxPoint x="30" y="1110" as="sourcePoint"/><mxPoint x="85" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arch-91" value="&lt;b&gt;GitOps and control&lt;/b&gt;: Argo CD pulls Git, admission check, image pull" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="95" y="1099" width="470" height="24" as="geometry"/></mxCell><mxCell id="arch-92" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2.5;strokeColor=#1a7f37;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="1110" as="sourcePoint"/><mxPoint x="645" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arch-93" value="&lt;b&gt;User traffic and data&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="655" y="1099" width="220" height="24" as="geometry"/></mxCell><mxCell id="arch-94" value='&lt;span style="color:#57606a"&gt;Build, scan, release, and signing: see the CI/CD diagram · Details and trade-offs: see README.md&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="1099" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cicd" name="CI/CD"><mxGraphModel dx="1800" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cicd-1" value="&lt;b&gt;Architecture 03 — CI/CD: build, scan, release, sign, and deploy&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=28;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="1800" height="40" as="geometry"/></mxCell><mxCell id="cicd-2" value="A push to main only builds and scans. A version tag releases the scanned image, ECR signs it, and Argo CD deploys it from Git.&lt;br&gt;Kyverno lets only images signed by our Signer profile run in the cluster." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=15;fontFamily=Helvetica;fontColor=#57606a;" vertex="1" parent="1"><mxGeometry x="100" y="54" width="1600" height="50" as="geometry"/></mxCell><mxCell id="cicd-3" value="① ② ③  Build and scan — every push to main" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#1f6feb;fillColor=#f5f9ff;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;strokeWidth=1;fontFamily=Helvetica;fontColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1760" height="280" as="geometry"/></mxCell><mxCell id="cicd-4" value="&lt;b&gt;Developer&lt;/b&gt;" style="shape=image;html=1;imageAspect=1;aspect=fixed;fontSize=12;fontFamily=Helvetica;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="82" y="197" width="56" height="56" as="geometry"/></mxCell><mxCell id="cicd-5" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;branch main" style="shape=image;html=1;imageAspect=1;aspect=fixed;fontSize=12;fontFamily=Helvetica;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="306" y="201" width="48" height="48" as="geometry"/></mxCell><mxCell id="cicd-6" value="&lt;b&gt;CI workflow&lt;/b&gt; (GitHub Actions)&lt;br&gt;test · build · tag &amp;lt;commit-id&amp;gt;" style="shape=image;html=1;imageAspect=1;aspect=fixed;fontSize=12;fontFamily=Helvetica;verticalLabelPosition=bottom;verticalAlign=top;align=center;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="576" y="201" width="48" height="48" as="geometry"/></mxCell><mxCell id="cicd-7" value="&lt;b&gt;IAM role: ci&lt;/b&gt;&lt;br&gt;OIDC · only from main" style="sketch=0;outlineCon