# Names and settings for Aurora MySQL (writer in the first AZ, reader in the second).

locals {
  rds = {
    subnet_group_name  = "${local.name_prefix}-dbsubnet"
    cluster_identifier = "${local.name_prefix}-aurora"
    engine             = "aurora-mysql" # no version pin: AWS's current default Aurora MySQL 3
    database_name      = "appdb"
    master_username    = "appadmin" # password is generated by RDS and kept in Secrets Manager
    instance_class     = var.db_instance_class

    backup_retention_days     = var.db_backup_retention_days
    deletion_protection       = var.deletion_protection
    skip_final_snapshot       = var.force_destroy # dev/stg: no snapshot on destroy; prd: keep one
    final_snapshot_identifier = "${local.name_prefix}-aurora-final"

    writer = {
      identifier     = "${local.name_prefix}-aurora-${local.az_suffix[0]}"
      az             = var.azs[0]
      promotion_tier = 0
    }
    reader = {
      identifier     = "${local.name_prefix}-aurora-${local.az_suffix[1]}"
      az             = var.azs[1]
      promotion_tier = 1 # promoted to writer if the writer fails
    }
  }
}
